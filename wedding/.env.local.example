# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@region.neon.tech/dbname?sslmode=require&channel_binding=require"

# App URL (for generating invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RSVP Password (set this to the actual password)
NEXT_PUBLIC_RSVP_PASSWORD=wedding2026

# Admin Password — gates /admin (guest list + CSV export).
# Server-only: never prefix with NEXT_PUBLIC_, and keep it different from the guest password.
ADMIN_PASSWORD=change-me
